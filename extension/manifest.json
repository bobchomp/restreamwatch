{
  "manifest_version": 3,
  "name": "RTMP Web Player Reminder",
  "version": "1.0.1",
  "description": "Reminds you that everything now runs through RTMP Web Player instead of Restream.",
  "permissions": ["declarativeNetRequestWithHostAccess", "tabs"],
  "host_permissions": ["*://restream.io/*", "*://*.restream.io/*"],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["warning.html"],
      "matches": ["*://restream.io/*", "*://*.restream.io/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
